{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --no-audit --no-fund && npm --prefix novel-audio-synthesizer/frontend install --no-audit --no-fund",
  "buildCommand": "npm --prefix novel-audio-synthesizer/frontend run build",
  "outputDirectory": "novel-audio-synthesizer/frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "novel-audio-synthesizer/backend/src/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/static/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|static/|assets/|models/|covers/|cursors/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
