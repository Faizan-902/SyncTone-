{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix novel-audio-synthesizer/frontend install",
  "buildCommand": "npm --prefix novel-audio-synthesizer/frontend run build",
  "outputDirectory": "novel-audio-synthesizer/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mars424-synctone-api.hf.space/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://mars424-synctone-api.hf.space/static/:path*"
    },
    {
      "source": "/((?!api/|static/|assets/|models/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
