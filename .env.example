# ==============================================================================
# SyncTone — Environment Configuration Template
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# In production, ensure all passwords, secrets, and keys are cryptographically
# generated (e.g. run `openssl rand -base64 32`).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Network Routing
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
FRONTEND_PORT=80

# Domain name for Caddy automatic HTTPS (e.g. synctone.yourdomain.com or test.nip.io)
# Leave as 'localhost' for local development or HTTP testing
DOMAIN_NAME=localhost
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 (Authoritative Core & Jobs Queue Broker)
# ------------------------------------------------------------------------------
POSTGRES_USER=synctone_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=synctone
POSTGRES_PORT=5432
# In Docker, api connects via internal network to 'postgres:5432':
DATABASE_URL=postgresql://synctone_user:replace_with_secure_postgres_password@postgres:5432/synctone

# ------------------------------------------------------------------------------
# 4. MongoDB 7.0 (Raw Chapters & Segment Timeline Documents)
# ------------------------------------------------------------------------------
MONGO_USER=synctone_user
MONGO_PASSWORD=replace_with_secure_mongo_password
MONGO_DB=synctone
MONGO_PORT=27017
# In Docker, api connects via internal network to 'mongo:27017':
MONGO_URI=mongodb://synctone_user:replace_with_secure_mongo_password@mongo:27017/synctone?authSource=admin

# ------------------------------------------------------------------------------
# 5. OpenStack Swift (Distributed Object Storage for .opus & Covers)
# ------------------------------------------------------------------------------
SWIFT_PORT=8080
SWIFT_AUTH_URL=http://swift:8080/auth/v1.0
SWIFT_USERNAME=test:tester
SWIFT_KEY=testing
SWIFT_CONTAINER_AUDIO=novel-chapters
SWIFT_CONTAINER_COVERS=novel-covers

# ------------------------------------------------------------------------------
# 6. Python Worker Daemon & Neural TTS Engine (Kokoro & Paradee)
# ------------------------------------------------------------------------------
WORKER_ID=synctone-worker-1
WORKER_POLL_INTERVAL_SEC=3
PYTHON_BIN=/opt/venv/bin/python3

# Model Weights Paths (Shared Docker Volume models_cache)
KOKORO_MODEL_PATH=/app/kokoro-tts-backend/models_cache/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/app/kokoro-tts-backend/models_cache/voices-v1.0.bin
PARADEE_MODEL_PATH=/app/kokoro-tts-backend/models_cache/paradee-v1.2-int8.onnx
PARADEE_VOICES_PATH=/app/kokoro-tts-backend/models_cache/paradee-voices.json
PCM_CACHE_DIR=/app/output/pcm_cache

# ------------------------------------------------------------------------------
# 7. AI Services (Attribution & OCR)
# ------------------------------------------------------------------------------
# Local Ollama or remote LLM endpoint
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Google Gemini API key (optional fallback for dialogue speaker attribution)
GEMINI_API_KEY=

# Unlimited OCR server URL (optional fallback for scanned book PDFs)
UNLIMITED_OCR_URL=

# ------------------------------------------------------------------------------
# 8. 100% Free Cloud Hosting (Vercel + HF Spaces/Render + Supabase/B2/R2 + Neon/Atlas)
# ------------------------------------------------------------------------------
# Set PG_SSL=true for Neon / Supabase PostgreSQL
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false

# Set LOW_MEMORY_MODE=true on 512MB RAM free containers (disables Kokoro-82M)
LOW_MEMORY_MODE=false
SKIP_HEAVY_MODELS=false

# CORS & Cookie Settings for Vercel (.vercel.app) <-> HF Spaces / Render
CORS_ORIGINS=https://synctone.vercel.app
ALLOW_VERCEL_PREVIEWS=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# S3-Compatible Bucket Storage (Supabase Storage S3, Backblaze B2, Cloudflare R2, MinIO)
# Leave STORAGE_PROVIDER=swift for local Docker Compose OpenStack Swift
STORAGE_PROVIDER=swift
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AUDIO=synctone-audio
S3_BUCKET_COVERS=synctone-covers
STORAGE_PUBLIC_AUDIO_URL=
STORAGE_PUBLIC_COVERS_URL=

# Frontend Build Env Vars (Configure in Vercel Dashboard)
# VITE_API_BASE_URL=/api
# VITE_UPLOAD_API_BASE_URL=https://<your-space>.hf.space/api
# VITE_WS_BASE_URL=wss://<your-space>.hf.space
# VITE_BACKEND_ORIGIN=https://<your-space>.hf.space
